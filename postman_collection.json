    {
      "name": "Transactions",
      "item": [
        {
          "name": "Transfer (Alice -> Bob)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"to_user_id\": \"{{bobId}}\",\n  \"amount\": 250.00,\n  \"description\": \"Pagamento de almoco\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/transactions/transfer",
              "host": ["{{baseUrl}}"],
              "path": ["api","v1","transactions","transfer"]
            },
            "description": "Requer accessToken da ALICE. Se vier 'cannot transfer to yourself', rode 'Auth -> Login (Alice)' antes."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Garante que o token logado é da Alice (senao da 'cannot transfer to yourself').",
                  "const tk = pm.collectionVariables.get('accessToken');",
                  "const aliceId = pm.collectionVariables.get('aliceId');",
                  "if (tk && aliceId) {",
                  "  try {",
                  "    let p = tk.split('.')[1].replace(/-/g,'+').replace(/_/g,'/');",
                  "    while (p.length % 4) p += '=';",
                  "    const uid = JSON.parse(atob(p)).user_id;",
                  "    if (uid !== aliceId) {",
                  "      throw new Error('Token atual nao e da Alice (user_id=' + uid + '). Rode Login (Alice) antes.');",
                  "    }",
                  "  } catch (e) { throw e; }",
                  "}"
                ]
              }
            }
          ]
        },

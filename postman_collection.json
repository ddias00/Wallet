{
  "info": {
    "name": "Digital Wallet API",
    "description": "Complete API collection for Digital Wallet platform — paths reais (corrigidos em 07/06/2026)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl",      "value": "http://localhost:8080", "type": "string" },
    { "key": "accessToken",  "value": "", "type": "string" },
    { "key": "refreshToken", "value": "", "type": "string" },
    { "key": "aliceId",      "value": "", "type": "string" },
    { "key": "bobId",        "value": "", "type": "string" },
    { "key": "bobEmail",     "value": "bob@wallet.com", "type": "string" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [ { "key": "token", "value": "{{accessToken}}", "type": "string" } ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Auto-refresh do JWT: se o access_token expira em <60s, chama /auth/refresh.",
          "const skipFor = ['/auth/login', '/auth/register', '/auth/refresh', '/health'];",
          "const url = (pm.request && pm.request.url) ? pm.request.url.toString() : '';",
          "if (skipFor.some(p => url.indexOf(p) !== -1)) { return; }",
          "",
          "const access  = pm.collectionVariables.get('accessToken');",
          "const refresh = pm.collectionVariables.get('refreshToken');",
          "if (!access || !refresh) { return; }",
          "",
          "function decodeExp(jwt) {",
          "  try {",
          "    let p = jwt.split('.')[1].replace(/-/g, '+').replace(/_/g, '/');",
          "    while (p.length % 4) { p += '='; }",
          "    const json = JSON.parse(atob(p));",
          "    return json.exp || 0;",
          "  } catch (e) { return 0; }",
          "}",
          "",
          "const exp = decodeExp(access);",
          "const now = Math.floor(Date.now() / 1000);",
          "if (exp - now > 60) { return; } // ainda válido por >60s",
          "",
          "const baseUrl = pm.collectionVariables.get('baseUrl');",
          "console.log('[auto-refresh] token expirando, renovando...');",
          "pm.sendRequest({",
          "  url: baseUrl + '/api/v1/auth/refresh',",
          "  method: 'POST',",
          "  header: { 'Content-Type': 'application/json' },",
          "  body: { mode: 'raw', raw: JSON.stringify({ refresh_token: refresh }) }",
          "}, function (err, res) {",
          "  if (err) { console.error('[auto-refresh] erro:', err); return; }",
          "  const j = res.json();",
          "  if (j && j.data && j.data.access_token) {",
          "    pm.collectionVariables.set('accessToken',  j.data.access_token);",
          "    pm.collectionVariables.set('refreshToken', j.data.refresh_token);",
          "    console.log('[auto-refresh] token renovado com sucesso');",
          "  } else {",
          "    console.warn('[auto-refresh] resposta inesperada:', res.text());",
          "  }",
          "});"
        ]
      }
    }
  ],

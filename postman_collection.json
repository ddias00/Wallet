                  "if (tk && bobId) {",
                  "  let p = tk.split('.')[1].replace(/-/g,'+').replace(/_/g,'/');",
                  "  while (p.length % 4) p += '=';",
                  "  const uid = JSON.parse(atob(p)).user_id;",
                  "  if (uid !== bobId) {",
                  "    throw new Error('Token atual nao e do Bob (user_id=' + uid + '). Rode Login (Bob) antes.');",
                  "  }",
                  "}"
                ]
              }
            }
          ]

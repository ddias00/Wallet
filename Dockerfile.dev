# Development Dockerfile with hot reload
FROM golang:1.27.2-alpine

# Install air for hot reload
RUN go install github.com/air-verse/air@v1.67.4

WORKDIR /app

# Copy go mod files
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY . .

# Generate the ignored Swagger package required by cmd/api.
RUN go run github.com/swaggo/swag/cmd/swag@v1.16.6 init -g cmd/api/main.go -o docs

# Expose port
EXPOSE 8080

# Run with air
CMD ["air", "-c", ".air.toml"]
